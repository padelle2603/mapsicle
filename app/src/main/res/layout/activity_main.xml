<?xml version="1.0" encoding="utf-8"?>
    <!-- targetSdk 36 = edge-to-edge mandatory: without fitsSystemWindows the panel at the
         top ends up under the status bar and the position button under the navigation
         bar. The two strips left free show the windowBackground. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- The compass, the button that brings the map back to north, is a child the
         library adds to the MapView on its own, and its default corner is top right:
         exactly where the panel below sits, opaque and with the higher elevation, so
         40 of its 48 dp ended up behind it, visible and tappable neither. Bottom left
         is the corner nothing else wants, once the MapLibre logo (88x23 dp) and the
         attribution icon that already sit there are accounted for. -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:maplibre_uiCompassGravity="bottom|start"
        app:maplibre_uiCompassMarginBottom="36dp" />

    <LinearLayout
        android:id="@+id/searchPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="12dp"
        android:background="@drawable/bg_panel"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/routeHeader"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="0dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/routeHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/itinerary_title"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/routeHeaderSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/itinerary_empty_summary"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/clearRouteButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/clear_itinerary"
                android:padding="12dp"
                android:src="@drawable/ic_close"
                android:tint="@color/icon_tint" />

            <ImageButton
                android:id="@+id/collapseButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/expand_route_panel"
                android:padding="12dp"
                android:rotation="180"
                android:src="@drawable/ic_expand_more"
                android:tint="@color/icon_tint" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/routeContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/start_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/startInput"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_search"
                        android:hint="@string/start_hint"
                        android:importantForAutofill="no"
                        android:imeOptions="actionSearch|flagNoExtractUi"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="16sp" />

                    <ImageButton
                        android:id="@+id/startGpsButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_search"
                        android:contentDescription="@string/use_gps_as_start"
                        android:padding="12dp"
                        android:src="@drawable/ic_my_location"
                        android:tint="@color/icon_tint" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/destination_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/destinationInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_search"
                    android:hint="@string/destination_hint"
                    android:importantForAutofill="no"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/suggestionStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <ScrollView
                    android:id="@+id/resultsScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/resultsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <RadioGroup
                        android:id="@+id/modeGroup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/walkMode"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:checked="true"
                            android:text="@string/mode_walk"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/bikeMode"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="@string/mode_bike"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/carMode"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="@string/mode_car"
                            android:textSize="12sp" />
                    </RadioGroup>

                    <Button
                        android:id="@+id/routeButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:enabled="false"
                        android:minWidth="84dp"
                        android:text="@string/calculate_route"
                        android:textAllCaps="false"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/routeStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/routeSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/acceptRouteButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:enabled="false"
                    android:text="@string/accept_route"
                    android:textAllCaps="false"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navigationContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/navigation_title"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/navigationInstruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/navigation_waiting"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/navigationDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/navigationProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/stopNavigationButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/stop_navigation"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- OSM credit always visible: ODbL obligation also with the panel collapsed.
             One touch opens the licences (texts in assets/licenses.txt). -->
        <TextView
            android:id="@+id/mapCredit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="@string/map_credit"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:gravity="end"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/locationButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_panel"
            android:contentDescription="@string/my_location"
            android:elevation="4dp"
            android:padding="16dp"
            android:src="@drawable/ic_my_location"
            android:tint="@color/icon_tint" />
    </LinearLayout>
</FrameLayout>
